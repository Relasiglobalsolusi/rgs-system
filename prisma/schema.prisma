generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  /// Direct DB URL for Prisma migrate/db push. On VPS local Postgres, use the same value as DATABASE_URL.
  directUrl = env("DIRECT_URL")
}

enum UserRole {
  ADMIN
}

enum EmployeeType {
  HEAD_OFFICE
  PROJECT_SITE
}

/// Full-time vs part-time employment (workforce model).
enum EmploymentType {
  FULL_TIME
  PART_TIME
}

/// Where the employee currently works — system-driven (Assign / Release / Leave), not a free dropdown.
enum Placement {
  AVAILABLE
  ON_PROJECT
  HEAD_OFFICE
  FIELD
  /// Set automatically when approved leave applies; cleared to AVAILABLE when leave ends.
  ON_LEAVE
}

enum EmploymentStatus {
  ACTIVE
  INACTIVE
  TERMINATED
  ON_LEAVE
  LEAVE_PENDING
  RESIGNED
}

/// Security deposit on the employee record (Internal Payroll withhold / resign).
enum SecurityDepositStatus {
  NONE
  HELD
  RETURNED
  KEPT_BY_COMPANY
}

/// Manual Internal Payroll lines. Return of security deposit is a payable (adds to net).
enum PayrollDeductionType {
  SECURITY_DEPOSIT
  LOST_STOCK
  PENALTY
  OTHER
  RETURN_OF_SECURITY_DEPOSIT
  /// Company paid the client for a site incident; employee is charged back.
  CLIENT_COMPENSATION
  /// Remaining Internal Payroll wage withheld after not-according-to-procedure resign.
  FORFEITED_WAGES
}

/// Operational Manager decision when CICO is under 9 hours (or 18 on a double shift).
enum InternalPayrollDayDecisionStatus {
  FULL_PAY
  CUSTOM
}

/// THR (Tunjangan Hari Raya) payment lifecycle.
enum ThrPaymentStatus {
  DRAFT
  GENERATED
  PAID
}

/// BPJS Kesehatan vs Ketenagakerjaan remittance line.
enum BpjsProgram {
  KESEHATAN
  KETENAGAKERJAAN
}

/// Inventory stock ledger entry types.
enum InventoryMovementType {
  PURCHASE
  ISSUE_TO_PROJECT
  ADJUSTMENT
  /// Permanent decrease with mandatory reason — OM+ only. Never silent.
  WRITE_OFF
  /// Stock sold externally — reduces on-hand; sale proceeds on InventorySale (income later).
  SOLD_OFF
  /// Warehouse send on a transfer order — stock left the warehouse, not yet booked to the project.
  IN_TRANSIT
  /// Equipment sent to the factory (stock leaves warehouse / stays off-hand).
  RETURN_TO_FACTORY
  /// Factory repair of the same unit, or a replacement box arriving as new stock.
  RECEIVE_FROM_FACTORY
}

/// Lifecycle status of a discrete Equipment asset (physical unit).
enum EquipmentAssetStatus {
  AVAILABLE
  ON_PROJECT
  /// Sent from warehouse, not yet received on the project.
  IN_TRANSIT
  /// Sent to the factory. Hanging until refund, same-unit repair, or replacement.
  AT_FACTORY
  RETIRED
}

enum FactoryReturnIntent {
  REFUND
  REPAIR
  REPLACE
}

enum FactoryReturnStatus {
  WAITING
  REPAIRED
  REPLACED
  REFUNDED
}

/// Staff material request → OM approve → warehouse transfer → site receive.
enum MaterialRequestStatus {
  REQUESTED
  APPROVED
  REJECTED
  CANCELLED
}

enum TransferOrderStatus {
  PENDING_SEND
  SENT
  RECEIVED
  /// Site reported the shipment did not arrive. Item return is open.
  NOT_RECEIVED
  /// Warehouse or manager returned the in-transit stock to warehouse.
  RETURNED
  /// Item return unresolved — Operations Manager must decide.
  NEEDS_ATTENTION
  /// Manager wrote off the in-transit stock. Audit trail kept.
  WRITTEN_OFF
  CANCELLED
}

enum ProjectStatus {
  PLANNED
  IN_PROGRESS
  /// Projects in mutual client + HO approval (Regular reconcile or General/Facade Submit for Approval).
  /// OM+ triggers Submit for Approval or reconcile → PDF compiled; both parties must agree.
  WAITING_FOR_APPROVAL
  /// Last approve done. Crew home. Payment / tax still open. CICO blocked.
  OFF_SITE
  COMPLETED
  ON_HOLD
  CANCELLED
}

enum ProjectSubCategory {
  REGULAR_CLEANING
  /// One-shot General Cleaning (Cleaning → One Time → General Cleaning).
  GENERAL_CLEANING
  /// One-shot Facade Cleaning (Cleaning → One Time → Facade Cleaning).
  FACADE_CLEANING
  /// Cleaning → General Cleaning (multi-visit / contract). Regular Cleaning billing.
  CONTRACT_GENERAL_CLEANING
  /// Cleaning → Facade Cleaning (multi-visit / contract). Regular Cleaning billing.
  CONTRACT_FACADE_CLEANING
  /// Ongoing monthly landscaping — same contract / reconcile flow as Regular Cleaning.
  REGULAR_LANDSCAPING
  /// One-time landscaping job — same billing / approval flow as General Cleaning.
  ONE_TIME_LANDSCAPING
  /// Company Head Office / Warehouse — no client billing; dual CICO (office + cleaning).
  INTERNAL
  /// Monthly security service for a client site (contract). One-time uses ONE_TIME_SECURITY.
  SECURITY
  /// Security → One Time — same billing / approval flow as General Cleaning.
  ONE_TIME_SECURITY
  /// Parking management — RGS revenue + optional client share/fees (no invoice periods).
  PARKING
  /// Client payroll management — RGS pays staff first; client reimburses + service fee.
  PAYROLL_MANAGEMENT
}

/// Permanent General / Facade / Landscaping crew roster. Assigned to jobs as a unit.
enum OperationsTeamKind {
  GENERAL_CLEANING
  FACADE_CLEANING
  LANDSCAPING
}

/// Desk home site for office CICO (HO Operations vs Warehouse). Cleaning staff use project assignment instead.
enum InternalHomeSite {
  NONE
  HEAD_OFFICE_OPERATIONS
  WAREHOUSE
}

/// Project work lane — matched to OM Approval Areas for approve/dashboard scope.
enum ServiceArea {
  CLEANING
  LANDSCAPING
  PARKING
  SECURITY
  HEAD_OFFICE
  /// Client payroll management service projects.
  PAYROLL_MANAGEMENT
  /// User-created project service area (catalog). Not an OM Approval Area.
  OTHER
}

/// Client organization type (tax identity + Multi-Project defaults).
enum ClientType {
  COMPANY
  INDIVIDUAL
}

/// Company / Individual keep Indonesian tax ID rules. Overseas does not.
enum VendorType {
  COMPANY
  INDIVIDUAL
  OVERSEAS
}

/// When Multi-Project Access is on: group codes, or master + group codes.
enum MultiProjectSecurityMode {
  GROUP_ONLY
  MASTER_AND_GROUP
}

/// Regular project billing period basis.
/// CONTRACT_CYCLE is the Custom Period option (user-entered from/to cycle).
enum BillingPeriodBasis {
  CALENDAR_MONTH
  CONTRACT_CYCLE
}

/// Client portal security code kind.
enum ClientSecurityCodeKind {
  MASTER
  GROUP
}

enum ProgressReportStatus {
  SUBMITTED
}

enum InvoicePeriodStatus {
  ONGOING
  COMPILING
  /// Reconcile / progress package sent; waiting for client Approve or Revise.
  AWAITING_CLIENT_REVIEW
  AWAITING_PAYMENT
  /// Client submitted proof of payment; awaiting admin/ops verification.
  PENDING_VERIFICATION
  PAID
  OVERDUE
}

/// What the client is reviewing before an invoice is issued.
enum ClientReviewKind {
  /// Regular Cleaning — CICO reconciliation report for the billing period.
  RECONCILIATION
  /// General / Facade — compiled progress reports for the billing period.
  PROGRESS
  /// Payroll Management — attendance + wage list for the client cutoff window.
  PAYROLL_MANAGEMENT
}

/// Client ↔ HO approval loop before invoice issue.
enum ClientReviewStatus {
  NONE
  /// Package sent; client must Approve or Revise.
  AWAITING_CLIENT
  /// Client approved — invoice should be (or was) auto-generated.
  CLIENT_APPROVED
  /// Client requested changes; waiting for HO under Finance → Reconciliation.
  CLIENT_REVISED
  /// HO accepted the client revision (revised amount/number may be set).
  HO_APPROVED_REVISION
  /// HO rejected the revision; back with HO note/proof for the client.
  HO_REJECTED_REVISION
}

/// Contract (Regular path) vs one-shot (General Cleaning path) for catalog subcategories.
enum ProjectCatalogBillingKind {
  CONTRACT
  ONE_TIME
}

/// How a project is billed.
/// MONTHLY — Regular Cleaning contracts (calendar-month periods).
/// ON_COMPLETION — short General/Facade: full invoice when work is done.
/// MILESTONE — General/Facade only: payment schedule (N periods at cumulative %) invoiced when ready.
enum BillingMode {
  MONTHLY
  ON_COMPLETION
  MILESTONE
  /// Finish each visit, invoice that visit, come back later. Not milestone %.
  MULTI_VISIT
}

enum PurchaseCategory {
  PRODUCT
  SERVICE
  /// Company cash entrusted to field / operations (float top-up).
  PETTY_CASH
  /// Tax or other government bill paid with a DJP Billing ID.
  GOVERNMENT
  /// Local company vehicle. Not warehouse stock. One plate per expense.
  VEHICLE
  /// Bank facility draw / installment / interest payment. Not stock.
  BANK_LOAN
}

/// Standby facility (KRK) vs term loan (kredit angsuran / anuitas).
enum BankLoanKind {
  STANDBY
  TERM
}

enum LoanSource {
  BANK
  SHAREHOLDER
}

enum LoanFacilityStatus {
  ACTIVE
  CLOSED
}

enum LoanMovementKind {
  DRAW
  REPAYMENT
}

/// How the stored interest percent is quoted. Monthly 1 = 1% this month. Annual 12 = 1% this month.
enum LoanInterestBasis {
  MONTHLY
  ANNUAL
}

/// What a government expense is settling (DJP / other state bills).
enum GovernmentTaxKind {
  /// Monthly Value Added Tax payment (PPN Kurang Bayar).
  PPN
  /// Monthly corporate income-tax installment (PPh Pasal 25 Badan).
  PPH_25
  /// Annual corporate income-tax settlement (PPh Pasal 29 Badan).
  PPH_29
  /// Employee withholding remittance (PPh Pasal 21).
  PPH_21
  /// Service withholding remittance (PPh Pasal 23).
  PPH_23
  /// Final income tax (PPh Pasal 4 ayat 2).
  PPH_4_2
  /// Income Tax Article 22 (import / certain purchases).
  PPH_22
  /// Stamp duty (Bea Meterai).
  STAMP_DUTY
  /// Land and Building Tax (PBB).
  PBB
  /// BPJS Kesehatan remittance (virtual account).
  BPJS_KESEHATAN
  /// BPJS Ketenagakerjaan remittance (virtual account).
  BPJS_KETENAGAKERJAAN
  OTHER
}

/// Tax on a local supplier bill or on what we charge a client.
enum CommercialTaxKind {
  /// Value Added Tax (PPN) — tax invoice / input or output VAT.
  PPN
  /// Income Tax Article 23 (PPh 23) — withholding, not a company tax credit.
  PPH_23
  /// Value Added Tax and Income Tax Article 23 together.
  PPN_AND_PPH_23
  /// Final Income Tax Article 4-2 — operating expense.
  PPH_4_2
  /// Value Added Tax and Final Income Tax Article 4-2 together.
  PPN_AND_PPH_4_2
  /// Employee Income Tax Article 21.
  PPH_21
  /// Income Tax Article 22.
  PPH_22
  /// Income Tax Article 26 (non-resident withholding).
  PPH_26
  /// Stamp duty (Bea Meterai).
  STAMP_DUTY
  /// Land and Building Tax (PBB).
  PBB
  OTHER
}

/// Bought locally vs imported from overseas.
enum PurchaseOrigin {
  LOCAL
  IMPORT
}

/// How an overseas import is handled after the vendor invoice.
enum ImportFulfillment {
  INTERNAL
  OUTSOURCED
}

/// Which import money is being recorded now (the rest can be marked paid later).
enum ImportPaidItems {
  INVOICE
  DUTIES
  BOTH
}

/// PPh Pasal 22 rate basis on an overseas import.
enum ImportPph22Basis {
  /// 2.5% — importer holds an Importer Identification Number (API).
  API
  /// 7.5% — no Importer Identification Number.
  WITHOUT_API
  /// Special commodity / manual rate.
  CUSTOM
}

/// What a Finance purchase is for — routes cost to stock, a project, or HO overhead.
enum PurchasePurpose {
  /// Warehouse / catalog stock-in (current default path).
  STOCK
  /// Expense belongs to a commercial project (requires projectId).
  PROJECT
  /// Internal / Head Office overhead — not a project cost and not stock-in.
  INTERNAL
  /// Funds the petty cash float. Not a P&L expense until spent.
  PETTY_CASH
}

/// Payroll Management project period (client employee list — not RGS CICO).
enum PayrollManagementPeriodStatus {
  DRAFT
  WAGES_ENTERED
  AWAITING_CLIENT
  CLIENT_APPROVED
  WAGES_PAID
  INVOICED
  /// Legacy. New periods settle on the invoice period (Paid), not this status.
  REIMBURSED
}

enum LeaveType {
  PERMISSION
  SICK
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

model Company {
  id        String   @id @default(cuid())
  name      String
  email     String?
  phone     String?
  address   String?
  /// Public company website (letterhead / footer).
  website   String?
  /// Company NPWP / tax ID (printed when present).
  npwp      String?

  /// Legacy single recipient bank. Kept in sync with the first CompanyBankAccount.
  bankName          String?
  bankAccountNumber String?
  /// Account holder name as printed on bank transfer proofs (optional).
  bankAccountName   String?

  bankAccounts CompanyBankAccount[]

  /// HO-typed opening cash. Displayed cash = opening + money in after − money out after.
  cashAtBankOpening     Decimal?  @db.Decimal(14, 2)
  cashAtBankOpeningAsOf DateTime? @db.Date

  users               User[]
  employees           Employee[]
  employeeCategories  EmployeeCategory[]
  positions           Position[]
  departments         Department[]
  clients             Client[]
  vendors             Vendor[]
  projects            Project[]
  invoiceCompilations InvoiceCompilation[]
  purchaseInvoices    PurchaseInvoice[]
  thrPayments         ThrPayment[]
  inventoryItems      InventoryItem[]
  inventoryPurchases  InventoryPurchase[]
  inventorySales      InventorySale[]
  inventoryMovements  InventoryMovement[]
  payrollDeductions   PayrollDeduction[]
  projectExpenses     ProjectExpense[]
  internalPayrollLocks InternalPayrollLock[]
  internalPayrollDayDecisions InternalPayrollDayDecision[]
  equipmentAssets     EquipmentAsset[]
  equipmentFactoryReturns EquipmentFactoryReturn[]
  materialRequests    MaterialRequest[]
  transferOrders      TransferOrder[]
  auditLogs           AuditLog[]
  websiteContent      WebsiteContent?
  operationsTeams     OperationsTeam[]
  pettyCashEntries    PettyCashEntry[]
  loanFacilities      LoanFacility[]
  bpjsRemittances     BpjsRemittance[]
  projectServiceAreas ProjectServiceAreaCatalog[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// Company recipient accounts printed on invoices and used to group receipts.
model CompanyBankAccount {
  id            String  @id @default(cuid())
  companyId     String
  company       Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  bankName      String
  accountNumber String
  accountHolder String
  label         String?
  sortOrder     Int      @default(0)
  createdAt     DateTime @default(now())

  projects       Project[]
  invoicePeriods ProjectInvoicePeriod[]
  inventorySales InventorySale[]
  purchaseInvoices PurchaseInvoice[]
  loanFacilities   LoanFacility[]
  loanMovements    LoanMovement[]

  @@index([companyId, sortOrder])
}

model WebsiteContent {
  id        String  @id @default(cuid())
  content   Json
  published Boolean @default(false)

  companyId String  @unique
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model EmployeeCategory {
  id        String  @id @default(cuid())
  name      String
  slug      String
  prefix    String
  active    Boolean @default(true)
  sortOrder Int     @default(100)

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  employees Employee[]
  positions Position[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([companyId, slug])
  @@unique([companyId, prefix])
}

/// Job title / role within a department (e.g. Operations → Cleaning staff).
model Position {
  id          String  @id @default(cuid())
  name        String
  slug        String
  description String?
  sortOrder   Int     @default(100)
  active      Boolean @default(true)

  categoryId String
  category   EmployeeCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  /// Default portal modules for new logins in this position.
  /// Users → Permissions can grant a specific person more access.
  defaultModuleAccess Json?

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  employees Employee[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([categoryId, slug])
  @@unique([categoryId, name])
  @@index([companyId, categoryId])
}

model Department {
  id          String  @id @default(cuid())
  name        String
  code        String  @unique
  description String?
  sortOrder   Int     @default(0)

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  employees Employee[]

  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Employee {
  id String @id @default(cuid())

  employeeNo String @unique
  firstName  String
  lastName   String

  email String?
  phone String?
  avatar String?
  idDocumentUrl String?

  gender              String?
  dateOfBirth         DateTime?
  address             String?
  city                String?
  country             String?
  emergencyContact    String?
  emergencyPhone      String?

  /// Denormalized display title from Position.name (kept for history / exports).
  position         String?
  positionId       String?
  jobPosition      Position?       @relation(fields: [positionId], references: [id], onDelete: SetNull)

  employmentType      EmploymentType   @default(FULL_TIME)
  placement           Placement        @default(AVAILABLE)
  /// Excel / form portal Yes/No — especially used for Corporate overrides.
  portalAccessRequested Boolean        @default(false)
  /// Optional note shown on login when access was revoked (e.g. PT off-project).
  loginRevokedReason  String?

  /// OM only: which Service Areas this manager may approve and see.
  omApprovalAreas     ServiceArea[]    @default([])
  /// OM and Area Manager: cover every project in their scope (OM still uses approval areas).
  manageAllProjects   Boolean          @default(false)
  /// Selected projects when manageAllProjects is off. Used by Area Manager and restricted OM.
  areaManagedProjects AreaManagerProject[]

  employeeType        EmployeeType     @default(PROJECT_SITE)
  /// Office-clock target for HO desk / warehouse desk staff (not used for field cleaners).
  internalHomeSite    InternalHomeSite @default(NONE)
  status              EmploymentStatus @default(ACTIVE)
  archivedFromDirectory Boolean @default(false)
  hiredAt      DateTime?

  /// Monthly base pay in IDR (upah pokok) — BPJS / THR reference wage.
  basePay Decimal? @db.Decimal(14, 2)
  bpjsKesehatanEnabled       Boolean @default(false)
  bpjsKetenagakerjaanEnabled Boolean @default(false)
  jhtEnabled Boolean @default(false)
  jpEnabled  Boolean @default(false)
  jkkEnabled Boolean @default(false)
  jkmEnabled Boolean @default(false)
  /// JKK company rate percent when enabled (0.10–1.60).
  jkkPercent Decimal? @db.Decimal(5, 2)

  /// HO checkbox: this employee may have a Security deposit taken in Internal Payroll.
  securityDepositRequired Boolean @default(false)
  /// When true, Internal Payroll pays full monthly salary (no CICO day count).
  cicoExempt Boolean @default(false)
  /// When true, Progress Report is not required or submitted. CICO still applies unless cicoExempt.
  progressExempt Boolean @default(false)
  /// Free-text bank for Internal Payroll PDF transfer instructions.
  bankName String?
  bankAccountNumber String?
  /// Account holder name — must match the bank book.
  bankAccountName String?
  /// Last commercial project used to attribute deposit return / kept.
  depositSourceProjectId String?
  depositSourceProject   Project? @relation("EmployeeDepositSource", fields: [depositSourceProjectId], references: [id], onDelete: SetNull)
  /// Security deposit withheld via Internal Payroll (sum of Security deposit lines).
  depositHeldAmount Decimal @default(0) @db.Decimal(14, 2)
  depositStatus     SecurityDepositStatus @default(NONE)

  lastWorkingDay DateTime? @db.Date
  resignAccordingToProcedure Boolean?
  /// Not according to procedure: remaining Internal Payroll is not paid and becomes last-project income.
  resignForfeitRemainingWages Boolean @default(false)
  resignNote     String?
  resignedAt     DateTime?

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  departmentId String?
  department   Department? @relation(fields: [departmentId], references: [id])

  categoryId String?
  category   EmployeeCategory? @relation(fields: [categoryId], references: [id])

  userId String? @unique
  user   User?   @relation(fields: [userId], references: [id])

  projectAssignments ProjectAssignment[]
  coveredBackupAssignments ProjectAssignment[] @relation("BackupCoveredEmployee")
  doubleShiftAssignments DoubleShiftAssignment[]
  coveredDoubleShifts DoubleShiftAssignment[] @relation("DoubleShiftCoveredEmployee")
  operationsTeamMembership OperationsTeamMember?
  progressReports    ProgressReport[]
  attendances        Attendance[]
  leaveRequests      LeaveRequest[]
  thrPayments        ThrPayment[]
  materialRequests   MaterialRequest[] @relation("MaterialRequestRequester")
  receivedTransfers  TransferOrder[]   @relation("TransferOrderReceiver")
  payrollDeductions  PayrollDeduction[]
  internalPayrollDayDecisions InternalPayrollDayDecision[]
  payrollManagementDayDecisions PayrollManagementDayDecision[]
  projectExpenses    ProjectExpense[]
  pettyCashEntries   PettyCashEntry[]

  /// Manual directory order (lower = higher in lists).
  sortOrder Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model User {
  id           String @id @default(cuid())
  name         String
  username     String @unique
  email        String? @unique
  passwordHash String
  passwordDisplay String?

  mustSetPassword Boolean @default(false)
  /// Set when the user finishes /first-login, /set-password, forgot-password, or admin password issue.
  passwordSetupCompletedAt DateTime?

  role             UserRole
  active           Boolean @default(true)
  moduleOverrides  Json?
  /// Per-user sidebar item order within sections: { "Operations": ["projects", ...], ... }
  sidebarOrder     Json?
  /// Manual directory order (lower = higher in lists).
  sortOrder        Int     @default(0)

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  clientId String?
  client   Client? @relation(fields: [clientId], references: [id])

  vendorId String?
  vendor   Vendor? @relation(fields: [vendorId], references: [id])

  employee Employee?

  reviewedLeaves        LeaveRequest[]       @relation("LeaveReviewer")
  auditLogs             AuditLog[]
  invoiceCompilations   InvoiceCompilation[] @relation("CompilationCreator")
  passwordResetTokens   PasswordResetToken[]
  compiledInvoicePeriods ProjectInvoicePeriod[] @relation("InvoicePeriodCompiler")
  taxInvoiceDonePeriods  ProjectInvoicePeriod[] @relation("TaxInvoiceAcknowledger")
  verifiedInvoicePeriods ProjectInvoicePeriod[] @relation("InvoicePaymentVerifier")
  reconciledInvoicePeriods ProjectInvoicePeriod[] @relation("InvoicePeriodReconciler")
  hoReviewedInvoicePeriods ProjectInvoicePeriod[] @relation("InvoicePeriodHoReviewer")
  createdPurchaseInvoices PurchaseInvoice[] @relation("PurchaseInvoiceCreator")
  paidPurchaseInvoices    PurchaseInvoice[] @relation("PurchaseInvoicePaidBy")
  reversedPurchaseInvoices PurchaseInvoice[] @relation("PurchaseInvoiceReversedBy")
  importDutiesPaidPurchases PurchaseInvoice[] @relation("PurchaseImportDutiesPaidBy")
  parkingMonthlyLogs      ParkingMonthlyLog[] @relation("ParkingLogCreator")
  payrollManagementPeriods PayrollManagementPeriod[] @relation("PayrollPeriodCreator")
  payrollWagesPaidPeriods  PayrollManagementPeriod[] @relation("PayrollPeriodWagesPaidBy")
  payrollInvoicedPeriods   PayrollManagementPeriod[] @relation("PayrollPeriodInvoicedBy")
  payrollReimbursedPeriods PayrollManagementPeriod[] @relation("PayrollPeriodReimbursedBy")
  payrollPdfLockedPeriods    PayrollManagementPeriod[] @relation("PayrollPeriodPdfLocker")
  payrollPdfUnlockedPeriods  PayrollManagementPeriod[] @relation("PayrollPeriodPdfUnlocker")
  createdInventoryPurchases InventoryPurchase[] @relation("InventoryPurchaseCreator")
  createdInventorySales     InventorySale[]     @relation("InventorySaleCreator")
  createdInventoryMovements InventoryMovement[] @relation("InventoryMovementCreator")
  createdPayrollDeductions  PayrollDeduction[]  @relation("PayrollDeductionCreator")
  createdProjectExpenses    ProjectExpense[]    @relation("ProjectExpenseCreator")
  lockedInternalPayrolls    InternalPayrollLock[] @relation("InternalPayrollLocker")
  unlockedInternalPayrolls  InternalPayrollLock[] @relation("InternalPayrollUnlocker")
  internalPayrollDayDecisions InternalPayrollDayDecision[] @relation("InternalPayrollDayDecider")
  payrollManagementDayDecisions PayrollManagementDayDecision[] @relation("PayrollManagementDayDecider")
  reviewedMaterialRequests  MaterialRequest[]   @relation("MaterialRequestReviewer")
  sentTransferOrders        TransferOrder[]     @relation("TransferOrderSender")
  progressWarningAcks   ProgressWarningAck[]
  leaveApprovalAcks     LeaveApprovalAck[]
  billingClientReviewEvents BillingClientReviewEvent[]
  createdPettyCashEntries   PettyCashEntry[] @relation("PettyCashEntryCreator")
  createdLoanFacilities     LoanFacility[]   @relation("LoanFacilityCreator")
  createdLoanMovements      LoanMovement[]   @relation("LoanMovementCreator")
  createdBpjsRemittances    BpjsRemittance[] @relation("BpjsRemittanceCreator")
  assignedDoubleShifts      DoubleShiftAssignment[] @relation("DoubleShiftAssignedBy")
  createdFactoryReturns     EquipmentFactoryReturn[] @relation("FactoryReturnCreator")
  closedFactoryReturns      EquipmentFactoryReturn[] @relation("FactoryReturnCloser")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

model Client {
  id                    String  @id @default(cuid())
  name                  String
  /// Normalized name for uniqueness (trim, collapse spaces, lowercase).
  nameNormalized        String?
  /// Short uniform code for filenames / refs (e.g. C001). Auto-assigned; not editable.
  shortCode             String
  /// Company vs Individual — drives tax ID rules and Multi-Project defaults.
  clientType            ClientType @default(COMPANY)
  email                 String?
  phone                 String?
  address               String?
  /// Company tax ID (NPWP) or individual NPWP/NIK — required on create/edit.
  npwp                  String?
  /// Uploaded NPWP (company) or NPWP/NIK (individual) document under /uploads/clients.
  taxIdDocumentUrl      String?
  contactPersonFirstName String?
  contactPersonLastName  String?
  contactPersonPosition  String?
  contactPersonEmail     String?
  contactPersonPhone     String?
  /// When the organization became an RGS client (tenure tracking).
  clientSince            DateTime @default(now())
  /// Legacy directory default. Product UI uses Project.paymentTermsDays only.
  paymentTermsDays       Int      @default(14)
  /// Manual directory order (lower = higher in lists).
  sortOrder              Int      @default(0)
  /// Opt-in Multi-Project Access (Security Codes after login).
  multiProjectAccess     Boolean @default(false)
  multiProjectSecurityMode MultiProjectSecurityMode?

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  projects       Project[]
  users          User[]
  projectGroups  ClientProjectGroup[]
  securityCodes  ClientSecurityCode[]
  inventorySales InventorySale[]

  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([companyId, shortCode])
  @@index([companyId, nameNormalized])
}

/// Project group for Multi-Project Access (one Security Code per group).
model ClientProjectGroup {
  id        String @id @default(cuid())
  name      String
  sortOrder Int    @default(0)

  clientId String
  client   Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  projects      Project[]
  securityCodes ClientSecurityCode[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([clientId])
}

/// Hashed Security Code for Master or Group unlock (letters + numbers).
model ClientSecurityCode {
  id             String                 @id @default(cuid())
  codeHash       String
  /// Last 2 chars hint for Admin UI only (optional).
  codeHint       String?
  kind           ClientSecurityCodeKind
  failedAttempts Int                    @default(0)
  lockedUntil    DateTime?
  active         Boolean                @default(true)
  /// Future face-verification enrollment placeholder.
  faceTemplateRef String?

  clientId String
  client   Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  groupId String?
  group   ClientProjectGroup? @relation(fields: [groupId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([clientId])
}

model Vendor {
  id                     String  @id @default(cuid())
  name                   String
  /// Short uniform code for filenames / refs (e.g. V001). Auto-assigned; not editable.
  shortCode              String
  /// Company / Individual require Indonesian Tax ID. Overseas does not.
  vendorType             VendorType @default(COMPANY)
  email                  String?
  phone                  String?
  address                String?
  /// Company tax ID (NPWP) or individual NPWP/NIK. Not used for Overseas vendors.
  npwp                   String?
  /// Uploaded NPWP (company) or NPWP/NIK (individual) document under /uploads/vendors.
  taxIdDocumentUrl       String?
  contactPersonFirstName String?
  contactPersonLastName  String?
  contactPersonPosition  String?
  contactPersonEmail     String?
  contactPersonPhone     String?
  /// When the organization became an RGS vendor/supplier (tenure tracking).
  vendorSince            DateTime @default(now())
  /// Payment terms in days after supplier invoice (0 = Cash; e.g. 14, 30).
  paymentTermsDays       Int      @default(14)
  /// Manual directory order (lower = higher in lists).
  sortOrder              Int      @default(0)

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  users User[]

  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  purchaseInvoices     PurchaseInvoice[]
  handlingPurchaseInvoices PurchaseInvoice[] @relation("PurchaseHandlingVendor")
  loanFacilities       LoanFacility[]
  inventoryPurchases   InventoryPurchase[]
  factoryReturns       EquipmentFactoryReturn[]

  @@unique([companyId, shortCode])
}

model Project {
  id          String        @id @default(cuid())
  name        String
  description String?
  location    String?
  latitude    Float?
  longitude   Float?
  locationRadiusMeters Int? @default(75)
  /// Planning estimate (contract/job). Kept when moving to In Progress / back to Planning.
  estimatedStartDate DateTime?
  /// General/Facade: initial estimated duration in days (planning / create). Kept for completed comparison.
  estimatedDurationDays Int?
  /// Real contract/job start — set when work order is received (Move to In Progress).
  startDate   DateTime?
  /// Real contract/job end (or expected completion for General/Facade).
  endDate     DateTime?
  /// Legacy field — cleaning projects use stage/progress reports instead of %.
  progress    Int           @default(0)
  /// Preferred day-of-month for anniversary auto-invoice (day after cycle period ends; derived from real startDate).
  invoicingDay Int          @default(1)
  /// Total / monthly contract value (IDR). Cleaning: set in billing. Security: monthly service fee at create.
  contractPrice Decimal?    @db.Decimal(14, 2)
  billingMode BillingMode   @default(MONTHLY)
  status      ProjectStatus @default(PLANNED)
  subCategory ProjectSubCategory @default(REGULAR_CLEANING)
  /// Work lane for OM Approval Areas / dashboard scope.
  serviceArea ServiceArea @default(CLEANING)
  /// Catalog row for Add Project / directory (system or user-created area).
  areaCatalogId String?
  areaCatalog   ProjectServiceAreaCatalog? @relation("ProjectAreaCatalog", fields: [areaCatalogId], references: [id], onDelete: SetNull)
  /// Catalog row for custom (or system) subcategory display / filters.
  subcategoryCatalogId String?
  subcategoryCatalog   ProjectSubcategoryCatalog? @relation("ProjectSubcategoryCatalog", fields: [subcategoryCatalogId], references: [id], onDelete: SetNull)
  /// Regular: Calendar Month vs Custom Period (stored as CONTRACT_CYCLE).
  billingPeriodBasis BillingPeriodBasis?
  /// Custom Period from day of month (1–31). Null = infer from contract start day (legacy).
  billingCycleStartDay Int?
  /// Custom Period to day of month (1–31). Null = same as from day (legacy anniversary).
  billingCycleEndDay Int?
  /// Signed contract proof — required before Planning → In Progress.
  contractDocumentUrl String?
  /// Early End Contract: last working day chosen; reconcile the day after.
  pendingEarlyEndReconcile Boolean @default(false)
  /// When true, each issued commercial invoice is queued for a tax invoice (faktur).
  requiresTaxInvoice Boolean @default(false)
  /// What tax we charge the client. Drives requiresTaxInvoice (VAT kinds only).
  chargedTaxKind CommercialTaxKind?
  /// Article 23 / 4-2 / other non-VAT rate when chargedTaxKind needs a percent.
  pphRatePercent Decimal? @db.Decimal(5, 2)
  /// Required when chargedTaxKind = OTHER.
  otherTaxName String?
  /// Parking: one-time initial setup cost (IDR).
  setupCost Decimal? @db.Decimal(14, 2)
  /// Parking: % of profit shared with the client (0 = none; all remainder for RGS after setup/monthly client fees).
  profitSharePercent Decimal? @db.Decimal(5, 2)
  /// Parking: monthly fees RGS pays the client (IDR).
  monthlyClientFee Decimal? @db.Decimal(14, 2)
  /// Payroll Management: RGS service fee % on reimbursed payroll (income).
  serviceFeePercent Decimal? @db.Decimal(5, 2)
  /// Days until the client pays this project’s invoice (0 = Cash). Same client, different project, different terms.
  paymentTermsDays Int?
  /// Payroll Management: client cutoff start day of month (1–31).
  payrollCutoffStartDay Int?
  /// Payroll Management: client cutoff end day of month (1–31).
  payrollCutoffEndDay Int?
  /// Payroll Management: tax % on the management fee only. Default 11.
  payrollTaxPercent Decimal? @db.Decimal(5, 2)
  /// Parking: monthly member fee per car (IDR). Not taxed.
  memberParkingUnitFee Decimal? @db.Decimal(14, 2)
  /// Parking: number of member cars on the monthly fee.
  memberParkingUnitCount Int?
  /// Parking: tax % on casual (normal traffic) revenue only. Default 10.
  parkingTaxPercent Decimal? @db.Decimal(5, 2)
  /// How many named site shifts this project runs (1–4). Hours are set on the project; HR assigns people to Shift 1–4.
  shiftCount Int @default(1)

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  /// Default company bank printed on new invoices for this project.
  bankAccountId String?
  bankAccount   CompanyBankAccount? @relation(fields: [bankAccountId], references: [id], onDelete: SetNull)

  clientId String?
  client   Client? @relation(fields: [clientId], references: [id])

  /// Multi-Project Access group (optional).
  groupId String?
  group   ClientProjectGroup? @relation(fields: [groupId], references: [id], onDelete: SetNull)

  assignments    ProjectAssignment[]
  shifts         ProjectShift[]
  doubleShiftAssignments DoubleShiftAssignment[]
  operationsTeamLinks OperationsTeamProject[]
  visits         ProjectVisit[]
  progressReports ProgressReport[]
  invoicePeriods ProjectInvoicePeriod[]
  attendances    Attendance[]
  progressWarningAcks ProgressWarningAck[]
  contractExtensions ClientContractExtension[]
  inventoryMovements InventoryMovement[]
  payrollDeductions  PayrollDeduction[]
  equipmentAssets    EquipmentAsset[]
  materialRequests   MaterialRequest[]
  transferOrders     TransferOrder[]
  parkingMonthlyLogs ParkingMonthlyLog[]
  payrollManagementPeriods PayrollManagementPeriod[]
  purchaseInvoices   PurchaseInvoice[]
  projectExpenses    ProjectExpense[]
  pettyCashEntries   PettyCashEntry[]
  depositSourcedEmployees Employee[] @relation("EmployeeDepositSource")
  areaManagers AreaManagerProject[]

  /// Manual directory order (lower = higher in lists).
  sortOrder Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([serviceArea])
  @@index([groupId])
  @@index([areaCatalogId])
  @@index([subcategoryCatalogId])
  @@index([bankAccountId])
}

/// Company-owned service areas for Add Project (system seed + user-created).
model ProjectServiceAreaCatalog {
  id            String      @id @default(cuid())
  companyId     String
  company       Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  slug          String
  nameEn        String
  nameId        String
  sortOrder     Int         @default(0)
  isSystem      Boolean     @default(false)
  /// Built-in area, or OTHER for user-created areas.
  systemArea    ServiceArea
  /// Cleaning / Security / Landscaping seed true; Parking / Payroll false.
  /// Custom areas follow the Add Service Area Enable One Time question.
  allowsOneTime Boolean     @default(true)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  subcategories   ProjectSubcategoryCatalog[]
  projects        Project[]                   @relation("ProjectAreaCatalog")
  operationsTeams OperationsTeam[]            @relation("TeamServiceAreaCatalog")

  @@unique([companyId, slug])
  @@index([companyId, sortOrder])
}

/// Subcategories under a project service area (system seed + user-created).
model ProjectSubcategoryCatalog {
  id                String                    @id @default(cuid())
  areaId            String
  area              ProjectServiceAreaCatalog @relation(fields: [areaId], references: [id], onDelete: Cascade)
  slug              String
  nameEn            String
  nameId            String
  sortOrder         Int                       @default(0)
  isSystem          Boolean                   @default(false)
  systemSubCategory ProjectSubCategory?
  billingKind       ProjectCatalogBillingKind @default(CONTRACT)
  createdAt         DateTime                  @default(now())
  updatedAt         DateTime                  @updatedAt

  projects Project[] @relation("ProjectSubcategoryCatalog")

  @@unique([areaId, slug])
  @@index([areaId, sortOrder])
}

/// Area Manager coverage — same approval authority as OM, limited to these projects.
model AreaManagerProject {
  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  projectId  String
  project    Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@id([employeeId, projectId])
  @@index([projectId])
}

/// History of Regular contract extensions (proof required; lengthen only).
model ClientContractExtension {
  id              String   @id @default(cuid())
  extendedOn      DateTime @default(now())
  previousEndDate DateTime
  newEndDate      DateTime
  proofUrl        String
  notes           String?

  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([projectId])
}

/// Legacy monthly invoice snapshot — unused by product UI. Kept so hard-delete
/// / scrub scripts and User/Company relations stay stable. Do not wire new flows.
model InvoiceCompilation {
  id           String  @id @default(cuid())
  year         Int
  month        Int
  locked       Boolean @default(false)
  snapshotData Json?

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  createdById String?
  createdBy   User?   @relation("CompilationCreator", fields: [createdById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([companyId, year, month])
}

/// Supplier bill / purchase invoice uploaded by RGS as buyer (PPN Masukan later).
model PurchaseInvoice {
  id String @id @default(cuid())

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  /// Vendor display name (snapshot from Vendor, or free-text when entered manually).
  supplierName String
  /// Optional link to the company vendor directory.
  vendorId String?
  vendor   Vendor? @relation(fields: [vendorId], references: [id], onDelete: SetNull)
  /// Vendor invoice number, or DJP Billing ID for government payments.
  invoiceRef   String
  /// Set when purchaseCategory = GOVERNMENT.
  governmentTaxKind GovernmentTaxKind?
  /// P&L slice when cash is bigger than the company cost (BPJS VA includes employee holding).
  governmentOperatingAmount Decimal? @db.Decimal(14, 2)
  invoiceDate  DateTime @db.Date
  amount       Decimal  @db.Decimal(14, 2)
  /// Stored under /uploads/purchase-invoices.
  filePath     String
  /// Optional faktur pajak (input VAT) — separate from the commercial purchase invoice.
  taxInvoiceFilePath    String?
  taxInvoiceUploadedAt  DateTime?
  /// Digits-only Kode dan Nomor Seri Faktur Pajak (duplicate detection across purchases).
  taxInvoiceSerial       String?
  /// Issued date printed on the Faktur Pajak (calendar day).
  taxInvoiceIssuedAt     DateTime? @db.Date
  /// SHA-256 of the uploaded tax invoice file (reuse detection).
  taxInvoiceDocumentHash String?
  notes        String?
  /// Warranty / complimentary goods — amount is 0 and there is no payable.
  freeOfCharge Boolean @default(false)
  /// Required when freeOfCharge (e.g. under warranty, replacement part).
  freeOfChargeReason String?
  /// FOC vendors often send no invoice. False hides invoice number / date / upload.
  hasInvoice Boolean @default(true)
  /// Extra cash for FOC goods (courier / freight) or FOC service related costs.
  shippingCurrency String?
  shippingForeignAmount Decimal? @db.Decimal(14, 4)
  /// Bank Rate when shipping / related cost is not Rupiah. Unused for IDR.
  shippingRateToIdr Decimal? @db.Decimal(18, 6)
  shippingIdr Decimal? @db.Decimal(14, 2)
  /// Duties or fees paid to release FOC goods. Proof is the Billing ID document.
  hasCustomsFees Boolean @default(false)
  /// Vendor / PIB declared value for Bea Cukai. Duty base when goods are free of charge.
  declaredValue Decimal? @db.Decimal(14, 4)
  declaredCurrency String?
  /// NDPBM for declared FX. Unused when declaredCurrency is IDR.
  declaredCustomsRate Decimal? @db.Decimal(18, 6)
  /// Whether the document includes PPN (input VAT) — for later PPN Masukan workflows.
  includesPpn  Boolean  @default(false)
  /// Local product/service: which tax is on the bill when Tax Included = Yes.
  includedTaxKind CommercialTaxKind?
  /// Article 23 / 4-2 / other non-VAT rate when includedTaxKind needs a percent.
  pphRatePercent Decimal? @db.Decimal(5, 2)
  /// Required when includedTaxKind = OTHER.
  otherTaxName String?
  /// Product goods vs service fee — VAT % often differs for services.
  purchaseCategory PurchaseCategory @default(PRODUCT)
  /// PPN rate percent when includesPpn (e.g. 11 or 12). Null when no VAT.
  ppnRatePercent Decimal? @db.Decimal(5, 2)
  /// STOCK (warehouse), PROJECT (tagged expense), or INTERNAL (HO overhead).
  purpose PurchasePurpose @default(STOCK)
  /// Required when purpose = PROJECT. Expense belongs to this project.
  projectId String?
  project   Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)

  /// Cash (0) or Net days for this supplier invoice. Import duties have no terms and are paid now.
  paymentTermsDays Int?

  /// Bought in Indonesia vs imported from overseas. Product expenses only.
  origin PurchaseOrigin @default(LOCAL)
  invoiceCurrency      String?
  invoiceForeignAmount Decimal? @db.Decimal(14, 4)
  /// Cash: Bank Rate of the transfer. Net: Booking Rate that locks warehouse factory Rupiah.
  exchangeRateToIdr    Decimal? @db.Decimal(18, 6)
  /// Bank Rate actually used when a Net import was paid. Booking Rate stays in exchangeRateToIdr.
  paidExchangeRateToIdr Decimal? @db.Decimal(18, 6)
  /// Signed Rupiah: (Bank Rate − Booking Rate) × factory FX. Positive = HO expense. Negative = HO income.
  importFxDifferenceIdr Decimal? @db.Decimal(14, 2)
  /// Customs Rate — the rate customs used when the goods arrived (CIF / duties).
  customsRateToIdr     Decimal? @db.Decimal(18, 6)
  /// Per-currency Customs Rates for CIF, e.g. { "USD": 16200, "RMB": 2250 }. No IDR key.
  customsRatesToIdr    Json?
  invoiceAmountIdr     Decimal? @db.Decimal(14, 2)
  freightCurrency      String?
  freightForeignAmount Decimal? @db.Decimal(14, 4)
  freightIdr           Decimal? @db.Decimal(14, 2)
  /// True when freight is remitted with the factory invoice (factory currency × Bank Rate).
  freightIncludedInInvoice Boolean @default(true)
  /// Own remittance rate when freight is not included. Unused when the line is Rupiah.
  freightRateToIdr     Decimal? @db.Decimal(18, 6)
  /// NDPBM for not-included FX freight. Unused when the line is Rupiah.
  freightCustomsRateToIdr Decimal? @db.Decimal(18, 6)
  insuranceCurrency    String?
  insuranceForeignAmount Decimal? @db.Decimal(14, 4)
  insuranceIdr         Decimal? @db.Decimal(14, 2)
  insuranceIncludedInInvoice Boolean @default(true)
  insuranceRateToIdr   Decimal? @db.Decimal(18, 6)
  /// NDPBM for not-included FX insurance. Unused when the line is Rupiah.
  insuranceCustomsRateToIdr Decimal? @db.Decimal(18, 6)
  bankFeeCurrency      String?
  bankFeeForeignAmount Decimal? @db.Decimal(14, 4)
  /// Bank Charge in Rupiah (SWIFT / cable). Not the sum of all bank fees.
  bankFeeIdr           Decimal? @db.Decimal(14, 2)
  fullAmountFeeCurrency String?
  fullAmountFeeForeignAmount Decimal? @db.Decimal(14, 4)
  /// Extra bank fee so the vendor receives the full transfer amount.
  fullAmountFeeIdr     Decimal? @db.Decimal(14, 2)
  /// Local bank telex fee, billed in Rupiah on the same transfer.
  localBankFeeIdr      Decimal? @db.Decimal(14, 2)
  clearanceCostIdr     Decimal? @db.Decimal(14, 2)
  formEApplied         Boolean  @default(false)
  beaMasukApplied      Boolean  @default(false)
  beaMasukRatePercent  Decimal? @db.Decimal(5, 2)
  beaMasukAmountIdr    Decimal? @db.Decimal(14, 2)
  ppnbmApplied         Boolean  @default(false)
  ppnbmRatePercent     Decimal? @db.Decimal(5, 2)
  ppnbmAmountIdr       Decimal? @db.Decimal(14, 2)
  importPpnAmountIdr   Decimal? @db.Decimal(14, 2)
  pph22Applied         Boolean  @default(false)
  pph22Basis           ImportPph22Basis?
  pph22RatePercent     Decimal? @db.Decimal(5, 2)
  pph22AmountIdr       Decimal? @db.Decimal(14, 2)
  customsValueIdr      Decimal? @db.Decimal(14, 2)
  importValueIdr       Decimal? @db.Decimal(14, 2)
  stockLandedCostIdr   Decimal? @db.Decimal(14, 2)

  importFulfillment ImportFulfillment?
  importPaidItems   ImportPaidItems?
  importDutiesBillingId String?
  importDutiesFilePath  String?
  importDutiesPaidAt    DateTime?
  importDutiesPaidById  String?
  importDutiesPaidBy    User?   @relation("PurchaseImportDutiesPaidBy", fields: [importDutiesPaidById], references: [id], onDelete: SetNull)
  importPpnBillingId    String?
  importPph22BillingId  String?
  handlingVendorId String?
  handlingVendor   Vendor? @relation("PurchaseHandlingVendor", fields: [handlingVendorId], references: [id], onDelete: SetNull)
  handlingFeeIdr Decimal? @db.Decimal(14, 2)
  handlingFeeIncludesPpn Boolean @default(false)
  handlingFeePpnRatePercent Decimal? @db.Decimal(5, 2)
  handlingFeeAmountPaidIdr Decimal? @db.Decimal(14, 2)
  handlingFeeTaxInvoicePath String?

  /// Indonesian finance lease for a company vehicle (DP, tenor, interest, bank fees).
  isVehicleLease Boolean @default(false)
  leaseOtrAmount Decimal? @db.Decimal(14, 2)
  leaseDownPayment Decimal? @db.Decimal(14, 2)
  leaseTenorMonths Int?
  leaseInterestPercentYear Decimal? @db.Decimal(6, 3)
  leaseAdminFee Decimal? @db.Decimal(14, 2)
  leaseInsuranceAmount Decimal? @db.Decimal(14, 2)
  leaseFiduciaryFee Decimal? @db.Decimal(14, 2)
  leaseProvisionFee Decimal? @db.Decimal(14, 2)
  leaseOtherFee Decimal? @db.Decimal(14, 2)
  leaseMonthlyInstallment Decimal? @db.Decimal(14, 2)

  /// Standby Facility (interest on the drawn amount) or Term Loan (fixed anuitas).
  bankLoanKind BankLoanKind?
  /// Term loan principal, or the standby amount currently drawn.
  bankLoanPrincipal Decimal? @db.Decimal(14, 2)
  /// Standby facility ceiling (unused portion does not accrue interest).
  bankLoanFacilityLimit Decimal? @db.Decimal(14, 2)
  bankLoanAnnualRatePercent Decimal? @db.Decimal(6, 3)
  bankLoanInterestRateBasis LoanInterestBasis?
  bankLoanTenorMonths Int?
  /// Computed anuitas installment for a term loan (reference, not the cash posting).
  bankLoanMonthlyInstallment Decimal? @db.Decimal(14, 2)
  /// Interbank transfer fee (SKN / BI-FAST / RTGS) booked with this payment.
  transferFeeIdr Decimal? @db.Decimal(14, 2)
  loanFacilityId String?
  loanFacility   LoanFacility? @relation(fields: [loanFacilityId], references: [id], onDelete: SetNull)
  loanSource     LoanSource?
  /// Principal portion of this loan repayment. Interest is loanInterestAmount.
  loanPrincipalAmount Decimal? @db.Decimal(14, 2)
  loanInterestAmount  Decimal? @db.Decimal(14, 2)
  /// Jakarta calendar month this unpaid/paid interest bill covers, e.g. 2026-06.
  loanInterestPeriod String?
  /// Early settlement penalty (denda pelunasan dipercepat). Expense, not principal.
  loanPenaltyAmount Decimal? @db.Decimal(14, 2)
  /// Bank admin / other fee. Expense, not principal or interest.
  loanAdminFeeAmount Decimal? @db.Decimal(14, 2)
  /// One-time bank provision (provisi). Expense, not principal or interest.
  loanProvisionAmount Decimal? @db.Decimal(14, 2)
  loanMovements  LoanMovement[]

  /// Number plate when this expense is a vehicle. Also used as the vehicle asset code.
  vehiclePlate String?
  /// Model year of the vehicle on this expense.
  vehicleYear Int?

  /// Company bank this purchase is paid from, or will be paid from.
  bankAccountId String?
  bankAccount   CompanyBankAccount? @relation(fields: [bankAccountId], references: [id], onDelete: SetNull)

  createdById String?
  createdBy   User?   @relation("PurchaseInvoiceCreator", fields: [createdById], references: [id])

  /// When AP was marked paid (proof uploaded + recorded).
  paidAt DateTime?
  /// Stored under /uploads/purchase-payment-proofs.
  paymentProofPath String?
  paidById String?
  paidBy   User?   @relation("PurchaseInvoicePaidBy", fields: [paidById], references: [id], onDelete: SetNull)
  /// Head Office confirmation reason when recording payment.
  paymentManualReason String?
  /// HO in-house confirm reason when accepting a tax invoice document.
  taxInvoiceManualReason String?

  lines PurchaseInvoiceLine[]
  pettyCashEntry PettyCashEntry?
  bpjsRemittances BpjsRemittance[]

  reversedAt DateTime?
  reversedById String?
  reversedBy User? @relation("PurchaseInvoiceReversedBy", fields: [reversedById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId])
  @@index([companyId, invoiceDate])
  @@index([companyId, paidAt])
  @@index([loanFacilityId])
  @@index([loanFacilityId, loanInterestPeriod])
  @@index([vendorId])
  @@index([taxInvoiceSerial])
  @@index([bankAccountId])
  @@index([taxInvoiceDocumentHash])
  @@index([taxInvoiceIssuedAt, amount])
  @@index([projectId])
  @@index([companyId, purpose])
}

/// Bank or shareholder facility. Draws are funding in. Returns reduce the payable.
model LoanFacility {
  id String @id @default(cuid())

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  source LoanSource
  kind   BankLoanKind
  status LoanFacilityStatus @default(ACTIVE)

  name       String
  lenderName String
  vendorId   String?
  vendor     Vendor? @relation(fields: [vendorId], references: [id], onDelete: SetNull)

  bankAccountId String?
  bankAccount   CompanyBankAccount? @relation(fields: [bankAccountId], references: [id], onDelete: SetNull)

  facilityLimit Decimal? @db.Decimal(14, 2)
  principal     Decimal? @db.Decimal(14, 2)
  chargesInterest Boolean @default(true)
  interestRateBasis LoanInterestBasis @default(ANNUAL)
  /// Quoted percent. Monthly 1 = 1% per month. Annual 12 = 12% per year.
  annualRatePercent Decimal? @db.Decimal(6, 3)
  /// Standby Actual/360 (Mandiri/BNI default) or Actual/365.
  dayCountYear Int @default(360)
  tenorMonths Int?
  monthlyInstallment Decimal? @db.Decimal(14, 2)
  startDate DateTime @db.Date
  notes     String?

  createdById String?
  createdBy   User? @relation("LoanFacilityCreator", fields: [createdById], references: [id], onDelete: SetNull)

  movements LoanMovement[]
  purchaseInvoices PurchaseInvoice[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId, status])
  @@index([companyId, source])
}

model LoanMovement {
  id String @id @default(cuid())

  facilityId String
  facility   LoanFacility @relation(fields: [facilityId], references: [id], onDelete: Cascade)

  kind         LoanMovementKind
  movementDate DateTime @db.Date
  amount       Decimal  @db.Decimal(14, 2)
  principalAmount Decimal? @db.Decimal(14, 2)
  interestAmount  Decimal? @db.Decimal(14, 2)
  transferFeeIdr  Decimal? @db.Decimal(14, 2)

  bankAccountId String?
  bankAccount   CompanyBankAccount? @relation(fields: [bankAccountId], references: [id], onDelete: SetNull)

  purchaseInvoiceId String?
  purchaseInvoice   PurchaseInvoice? @relation(fields: [purchaseInvoiceId], references: [id], onDelete: SetNull)

  notes    String?
  filePath String?

  reversedAt DateTime?

  createdById String?
  createdBy   User? @relation("LoanMovementCreator", fields: [createdById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([facilityId, movementDate])
  @@index([purchaseInvoiceId])
}

/// Line items on a Finance purchase (catalog item + qty + unit cost).
model PurchaseInvoiceLine {
  id String @id @default(cuid())

  purchaseInvoiceId String
  purchaseInvoice   PurchaseInvoice @relation(fields: [purchaseInvoiceId], references: [id], onDelete: Cascade)

  itemId String?
  item   InventoryItem? @relation(fields: [itemId], references: [id], onDelete: Restrict)
  /// Free-text service description when there is no catalog item.
  description String?
  /// Purchase unit of measure (piece, box, kilogram, liter, …).
  unit String?
  /// When buying a pack (box / drum / …), how many stock units are inside each pack.
  packContents Decimal? @db.Decimal(14, 3)

  quantity   Decimal @db.Decimal(14, 3)
  unitPrice  Decimal @db.Decimal(14, 2)
  totalPrice Decimal @db.Decimal(14, 2)
  sortOrder  Int     @default(0)

  /// Stock-in created when this line tracks inventory.
  inventoryPurchase InventoryPurchase?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([purchaseInvoiceId])
  @@index([itemId])
}

/// Named site shift on a project (Shift 1, Shift 2, …). Times are the roster template.
model ProjectShift {
  id String @id @default(cuid())

  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  /// 1-based shift number on this project.
  number Int
  startTime String
  endTime   String

  assignments ProjectAssignment[]
  coveringDoubleShifts DoubleShiftAssignment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([projectId, number])
  @@index([projectId])
}

model ProjectAssignment {
  id String @id @default(cuid())

  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  shiftId String?
  shift   ProjectShift? @relation(fields: [shiftId], references: [id], onDelete: SetNull)

  /// Staff shift start as HH:mm (local). Expected clock-in is before this time.
  shiftStart String?
  /// Staff shift end as HH:mm (local). May be earlier than start for overnight shifts.
  shiftEnd String?
  /// Part-time backup covering a full-time absence.
  isBackup Boolean @default(false)
  /// Regular employee whose named shift this backup covers.
  coveredEmployeeId String?
  coveredEmployee   Employee? @relation("BackupCoveredEmployee", fields: [coveredEmployeeId], references: [id], onDelete: SetNull)
  backupStartDate DateTime? @db.Date
  backupEndDate DateTime? @db.Date
  /// Daily cash rate for a part-time backup. Not monthly base pay.
  dailyRate Decimal? @db.Decimal(14, 2)
  pettyCashEntries PettyCashEntry[]

  assignedAt DateTime @default(now())

  @@unique([projectId, employeeId])
  @@index([shiftId])
  @@index([coveredEmployeeId])
}

/// Same full-time employee covers the next shift on this date (not overtime).
/// Pays two Internal Payroll daily rates for that calendar day after complete CICO.
model DoubleShiftAssignment {
  id String @id @default(cuid())

  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  /// The extra named shift this employee takes over (the absent person's shift).
  coveringShiftId String?
  coveringShift   ProjectShift? @relation(fields: [coveringShiftId], references: [id], onDelete: SetNull)

  /// Regular employee whose shift is being covered that date.
  coveredEmployeeId String?
  coveredEmployee   Employee? @relation("DoubleShiftCoveredEmployee", fields: [coveredEmployeeId], references: [id], onDelete: SetNull)

  /// Jakarta calendar date the employee covers two shifts at this site.
  date DateTime @db.Date

  assignedById String
  assignedBy   User   @relation("DoubleShiftAssignedBy", fields: [assignedById], references: [id])

  createdAt DateTime @default(now())

  @@unique([employeeId, date])
  @@index([projectId, date])
  @@index([assignedById])
  @@index([coveringShiftId])
  @@index([coveredEmployeeId])
}

enum PettyCashEntryKind {
  TOP_UP
  SPEND
  PART_TIME_PAY
}

enum PettyCashEntryStatus {
  SCHEDULED
  POSTED
  VOIDED
}

/// Field cash float: top-ups from Expenses, spends, and daily part-time pay.
model PettyCashEntry {
  id        String @id @default(cuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  kind   PettyCashEntryKind
  status PettyCashEntryStatus @default(POSTED)
  /// Always a positive IDR amount.
  amount Decimal @db.Decimal(14, 2)
  /// Legacy OCR amount. Kept so local db push never drops existing rows.
  extractedAmount Decimal? @db.Decimal(14, 2)
  entryDate DateTime @db.Date
  description String

  purchaseInvoiceId String? @unique
  purchaseInvoice   PurchaseInvoice? @relation(fields: [purchaseInvoiceId], references: [id], onDelete: SetNull)

  projectId String?
  project   Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)

  employeeId String?
  employee   Employee? @relation(fields: [employeeId], references: [id], onDelete: SetNull)

  assignmentId String?
  assignment   ProjectAssignment? @relation(fields: [assignmentId], references: [id], onDelete: SetNull)

  createdById String?
  createdBy   User? @relation("PettyCashEntryCreator", fields: [createdById], references: [id], onDelete: SetNull)
  postedAt DateTime?

  /// Bill / receipt photo for spends. Required before a spend can post.
  proofPath String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId, entryDate])
  @@index([companyId, status, kind])
  @@index([assignmentId])
  @@index([projectId])
}

/// Permanent operations team for one project service area (catalog type).
model OperationsTeam {
  id        String              @id @default(cuid())
  companyId String
  company   Company             @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name      String
  /// Legacy GC / Facade / Landscaping type. New teams use serviceAreaCatalogId.
  kind      OperationsTeamKind?
  serviceAreaCatalogId String?
  serviceAreaCatalog   ProjectServiceAreaCatalog? @relation("TeamServiceAreaCatalog", fields: [serviceAreaCatalogId], references: [id], onDelete: SetNull)

  members      OperationsTeamMember[]
  projectLinks OperationsTeamProject[]

  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId, kind])
  @@index([companyId, serviceAreaCatalogId])
}

model OperationsTeamMember {
  id         String         @id @default(cuid())
  teamId     String
  team       OperationsTeam @relation(fields: [teamId], references: [id], onDelete: Cascade)
  employeeId String         @unique
  employee   Employee       @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  assignedAt DateTime       @default(now())

  @@unique([teamId, employeeId])
  @@index([teamId])
}

/// Team deployed to a General / Facade job. Same teams persist across visits.
model OperationsTeamProject {
  id        String         @id @default(cuid())
  teamId    String
  team      OperationsTeam @relation(fields: [teamId], references: [id], onDelete: Cascade)
  projectId String
  project   Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  assignedAt DateTime      @default(now())

  @@unique([teamId, projectId])
  @@index([projectId])
}

/// One site visit on a General / Facade multi-visit job (not a milestone %).
model ProjectVisit {
  id        String  @id @default(cuid())
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  visitIndex Int
  startDate DateTime @db.Date
  endDate   DateTime @db.Date
  amount    Decimal? @db.Decimal(14, 2)
  invoicePeriodId String? @unique
  invoicePeriod   ProjectInvoicePeriod? @relation(fields: [invoicePeriodId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([projectId, visitIndex])
  @@index([projectId])
}

/// Staff stage / progress report with photo documentation for cleaning projects.
model ProgressReport {
  id String @id @default(cuid())

  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  reportDate DateTime @db.Date
  /// UI: "Service area" — where/what zone was cleaned (lobby, restrooms).
  stageLabel String?
  notes      String?
  status     ProgressReportStatus @default(SUBMITTED)

  invoicePeriodId String?
  invoicePeriod   ProjectInvoicePeriod? @relation(fields: [invoicePeriodId], references: [id], onDelete: SetNull)

  photos ProgressReportPhoto[]

  /// Manual directory order (lower = higher in lists).
  sortOrder Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([projectId, reportDate])
  @@index([invoicePeriodId])
}

model ProgressReportPhoto {
  id String @id @default(cuid())

  progressReportId String
  progressReport   ProgressReport @relation(fields: [progressReportId], references: [id], onDelete: Cascade)

  url     String
  caption String?

  createdAt DateTime @default(now())
}

/// Persisted dismissal of a "missing progress report" warning for a user.
model ProgressWarningAck {
  id String @id @default(cuid())

  userId String
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  /// Calendar day that had no progress report (Asia/Jakarta date-only).
  reportDate DateTime @db.Date

  acknowledgedAt DateTime @default(now())

  @@unique([userId, projectId, reportDate])
  @@index([userId])
}

/// Persisted dismissal of a "leave approved" dashboard notification for a user.
model LeaveApprovalAck {
  id String @id @default(cuid())

  userId String
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  leaveRequestId String
  leaveRequest   LeaveRequest @relation(fields: [leaveRequestId], references: [id], onDelete: Cascade)

  acknowledgedAt DateTime @default(now())

  @@unique([userId, leaveRequestId])
  @@index([userId])
}

/// Monthly, milestone, or completion billing period for a cleaning project.
model ProjectInvoicePeriod {
  id String @id @default(cuid())

  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  periodStart DateTime @db.Date
  periodEnd   DateTime @db.Date
  label       String?
  status      InvoicePeriodStatus @default(ONGOING)

  /// Invoice amount for this period (IDR). Null for legacy monthly compiles without a price.
  amount           Decimal? @db.Decimal(14, 2)
  /// Company bank account printed on this invoice and used for receipt grouping.
  bankAccountId    String?
  bankAccount      CompanyBankAccount? @relation(fields: [bankAccountId], references: [id], onDelete: SetNull)
  /// Cumulative project progress % this milestone represents (e.g. 30, 60, 100).
  milestonePercent Float?

  invoicePdfPath String?
  reportCount    Int     @default(0)
  submittedAt    DateTime?
  /// Payment due date — set on submit (issue date + client paymentTermsDays; 0 = Cash).
  dueAt          DateTime?
  paidAt         DateTime?
  compileNote    String?

  /// Staff reconciled the cycle (progress/amount check) before submitting the invoice.
  /// Required for MONTHLY (Regular Cleaning) in-progress invoicing.
  reconciledAt   DateTime?
  reconciledById String?
  reconciledBy   User?     @relation("InvoicePeriodReconciler", fields: [reconciledById], references: [id])

  /// Client portal review of reconcile / progress package before invoice issue.
  clientReviewKind   ClientReviewKind?
  clientReviewStatus ClientReviewStatus @default(NONE)
  /// PDF of the reconciliation (CICO) or progress package sent to the client.
  reviewReportPdfPath String?
  reviewSentToClientAt DateTime?
  clientReviewedAt     DateTime?
  clientRevisionNote   String?
  /// Client upload under /uploads/client-review-proofs.
  clientRevisionProofPath String?
  hoReviewNote         String?
  hoReviewProofPath    String?
  hoReviewedAt         DateTime?
  hoReviewedById       String?
  hoReviewedBy         User?     @relation("InvoicePeriodHoReviewer", fields: [hoReviewedById], references: [id])
  /// When HO approves a client revision, they may set a revised commercial amount/number.
  revisedInvoiceAmount Decimal? @db.Decimal(14, 2)
  revisedInvoiceNumber String?

  reviewEvents BillingClientReviewEvent[]
  payrollManagementPeriod PayrollManagementPeriod?

  /// Client-uploaded proof of payment (image or PDF under /uploads/payment-proofs).
  paymentProofPath       String?
  paymentProofUploadedAt DateTime?
  paymentVerifiedAt      DateTime?
  paymentVerifiedById    String?
  paymentVerifiedBy      User?     @relation("InvoicePaymentVerifier", fields: [paymentVerifiedById], references: [id])
  /// Head Office confirmation reason when accepting proof of payment.
  paymentManualReason String?
  /// HO in-house confirm reason when marking a tax invoice sent.
  taxInvoiceManualReason String?

  /// Copied from project.requiresTaxInvoice when the invoice is issued.
  taxInvoiceRequired Boolean   @default(false)
  /// Output PPN rate % used when marking/splitting tax invoice (editable; default ~11–12).
  ppnRatePercent Decimal? @db.Decimal(5, 2)
  /// Uploaded tax invoice (faktur pajak) document under /uploads/tax-invoices.
  taxInvoiceDocumentPath       String?
  taxInvoiceDocumentUploadedAt DateTime?
  /// Digits-only Kode dan Nomor Seri Faktur Pajak (for duplicate detection).
  taxInvoiceSerial             String?
  /// Issued date printed on the Faktur Pajak (calendar day).
  taxInvoiceIssuedAt           DateTime? @db.Date
  /// SHA-256 of the uploaded tax invoice file (reuse detection).
  taxInvoiceDocumentHash       String?
  /// When set, this period leaves the Tax Invoice reminder queue.
  taxInvoiceDoneAt   DateTime?
  taxInvoiceDoneById String?
  taxInvoiceDoneBy   User?     @relation("TaxInvoiceAcknowledger", fields: [taxInvoiceDoneById], references: [id])

  compiledById String?
  compiledBy   User?   @relation("InvoicePeriodCompiler", fields: [compiledById], references: [id])

  reports ProgressReport[]
  visit   ProjectVisit?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([projectId, periodStart, periodEnd])
  @@index([projectId, status])
  @@index([clientReviewStatus])
  @@index([taxInvoiceRequired, taxInvoiceDoneAt])
  @@index([taxInvoiceSerial])
  @@index([taxInvoiceDocumentHash])
  @@index([taxInvoiceIssuedAt, amount])
  @@index([bankAccountId])
}

/// Audit trail for client ↔ HO reconcile / progress approval rounds.
model BillingClientReviewEvent {
  id String @id @default(cuid())

  invoicePeriodId String
  invoicePeriod   ProjectInvoicePeriod @relation(fields: [invoicePeriodId], references: [id], onDelete: Cascade)

  /// Actor role for the event: CLIENT | HO | SYSTEM
  actorRole String
  userId    String?
  user      User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  /// e.g. SENT_TO_CLIENT, CLIENT_APPROVED, CLIENT_REVISED, HO_APPROVED, HO_REJECTED, INVOICE_ISSUED
  action String
  note   String?
  proofPath String?
  /// Snapshot of review status after this event.
  statusAfter ClientReviewStatus?

  createdAt DateTime @default(now())

  @@index([invoicePeriodId, createdAt])
  @@index([userId])
}

model Attendance {
  id String @id @default(cuid())

  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  projectId String?
  project   Project? @relation(fields: [projectId], references: [id])

  date     DateTime  @db.Date
  checkIn  DateTime?
  checkOut DateTime?
  note     String?

  checkInLat            Float?
  checkInLng            Float?
  checkOutLat           Float?
  checkOutLng           Float?
  checkInDistanceMeters  Float?
  checkOutDistanceMeters Float?

  /** On-site proof photo captured at check-in (public path under /uploads/cico). */
  checkInPhotoUrl String?

  /** On-site proof photo captured at check-out (public path under /uploads/cico). */
  checkOutPhotoUrl String?

  /// Field/office late check-in flag (mirrors attendance report).
  lateCheckIn Boolean @default(false)
  /// Field/office early check-out flag — no auto pay deduction.
  earlyCheckOut Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// One complete CICO session per employee × calendar date × site.
  @@unique([employeeId, date, projectId])
  @@index([employeeId, date])
}

model LeaveRequest {
  id String @id @default(cuid())

  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  type      LeaveType
  startDate DateTime  @db.Date
  endDate   DateTime  @db.Date
  reason    String
  proofUrl  String?

  status     ApprovalStatus @default(PENDING)
  reviewNote String?

  reviewedById String?
  reviewedBy   User?     @relation("LeaveReviewer", fields: [reviewedById], references: [id])
  reviewedAt   DateTime?

  approvalAcks LeaveApprovalAck[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// Catalog item only — purchases/issues are separate records that reference this.
model InventoryItem {
  id String @id @default(cuid())
  /// System-generated from Item Type ({TYPE}-{###}, e.g. TOOL-001). Not user-editable.
  sku String
  name String
  /// High-level type (e.g. Consumable, Equipment, Chemical). Also drives SKU prefix.
  itemType String
  description String?
  /// Display unit for stock qty (pcs, kg, l, box, …).
  unit String @default("pcs")
  /// Low-stock warning threshold (stock ops, not catalog create).
  minStock Decimal @default(0) @db.Decimal(14, 3)
  /// Cached on-hand qty; kept in sync with InventoryMovement in the same transaction.
  currentStock Decimal @default(0) @db.Decimal(14, 3)
  /// Last purchase unit cost (IDR) — set by purchases only.
  lastUnitCost Decimal? @db.Decimal(14, 2)
  /// Running weighted-average unit cost used when issuing to projects.
  avgUnitCost Decimal? @db.Decimal(14, 2)
  /// Manual directory order (lower = higher in lists).
  sortOrder Int     @default(0)
  active    Boolean @default(true)
  /// Soft-delete / archive. When set, hidden from catalog and pickers; history rows keep itemId.
  deletedAt DateTime?
  /// When false (e.g. Consulting Fee), purchase lines record cost only — no stock.
  tracksStock Boolean @default(true)

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  purchases InventoryPurchase[]
  sales     InventorySale[]
  movements InventoryMovement[]
  purchaseInvoiceLines PurchaseInvoiceLine[]
  equipmentAssets EquipmentAsset[]
  factoryReturns EquipmentFactoryReturn[]
  materialRequestLines MaterialRequestLine[]
  transferOrderLines   TransferOrderLine[]
  payrollDeductions    PayrollDeduction[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([companyId, sku])
  @@index([companyId, active])
  @@index([companyId, deletedAt])
  @@index([companyId, sortOrder])
  @@index([companyId, itemType])
}

/// Stock-in receipt from a vendor (linked to a PURCHASE movement).
model InventoryPurchase {
  id          String   @id @default(cuid())
  purchasedAt DateTime @db.Date
  quantity    Decimal  @db.Decimal(14, 3)
  unitPrice   Decimal  @db.Decimal(14, 2)
  totalPrice  Decimal  @db.Decimal(14, 2)
  invoiceNo   String?
  /// Optional receipt/invoice scan under /uploads/inventory.
  receiptUrl  String?
  notes       String?

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  itemId String
  item   InventoryItem @relation(fields: [itemId], references: [id], onDelete: Restrict)

  vendorId String
  vendor   Vendor @relation(fields: [vendorId], references: [id], onDelete: Restrict)

  /// Ledger row created with this purchase (1:1).
  movementId String             @unique
  movement   InventoryMovement  @relation(fields: [movementId], references: [id], onDelete: Cascade)

  /// Optional link back to the Finance purchase line that created this stock-in.
  purchaseInvoiceLineId String?             @unique
  purchaseInvoiceLine   PurchaseInvoiceLine? @relation(fields: [purchaseInvoiceLineId], references: [id], onDelete: SetNull)

  createdById String?
  createdBy   User?   @relation("InventoryPurchaseCreator", fields: [createdById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId, purchasedAt])
  @@index([itemId])
  @@index([vendorId])
}

/// External stock sale (linked to a SOLD_OFF movement). Sale proceeds for future FR income.
model InventorySale {
  id       String   @id @default(cuid())
  soldAt   DateTime @db.Date
  quantity Decimal  @db.Decimal(14, 3)
  /// Pre-tax (ex-PPN) sale unit price (IDR).
  unitPrice  Decimal @db.Decimal(14, 2)
  /// Tax-inclusive sale total (subtotal + taxAmount). Company income in Financial Report.
  totalPrice Decimal @db.Decimal(14, 2)
  /// Pre-tax sale total (DPP) = qty × unitPrice.
  subtotal Decimal @db.Decimal(14, 2) @default(0)
  /// PPN / VAT amount on the sale (subtotal × taxRatePercent).
  taxAmount Decimal @db.Decimal(14, 2) @default(0)
  /// PPN rate as percent (e.g. 11). Null on legacy rows; required on new sold-offs.
  taxRatePercent Decimal? @db.Decimal(5, 2)
  /// Buyer display name (company name when COMPANY; person name when INDIVIDUAL).
  buyer    String?
  /// Individual vs Company — drives NPWP text requirement and client-link filtering.
  buyerType ClientType?
  /// Person-in-charge name (required for COMPANY buyers).
  buyerPicName String?
  /// Buyer's National ID (KTP/NIK). Individual buyers need this OR buyerTaxId (at least one).
  buyerIdNumber String?
  /// Buyer's Tax ID (NPWP). Required when buyerType = COMPANY; one-of-two option (with buyerIdNumber) when INDIVIDUAL.
  buyerTaxId String?
  /// Optional company registration / NIB (not required for tax capture).
  buyerRegistration String?
  /// Buyer / PIC contact phone (required on new sold-offs).
  buyerPhone String?
  /// Tax invoice (Faktur Pajak) issued by us to the buyer. Required on new sold-offs for COMPANY buyers only — individuals cannot be issued a tax invoice.
  buyerIdentityDocUrl String?
  /// Generated sale invoice PDF URL (written automatically on record).
  invoiceUrl String?
  /// Customer payment proof (transfer receipt / bank slip). Optional at record time.
  paymentProofUrl String?
  /// Date the customer payment was received. Defaults to soldAt when proof is uploaded at record time.
  paidAt DateTime? @db.Date
  notes    String?

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  /// Company bank account the buyer pays to (sale invoice / Financial Report).
  bankAccountId String?
  bankAccount   CompanyBankAccount? @relation(fields: [bankAccountId], references: [id], onDelete: SetNull)

  itemId String
  item   InventoryItem @relation(fields: [itemId], references: [id], onDelete: Restrict)

  /// Optional link to an existing Client directory record.
  clientId String?
  client   Client? @relation(fields: [clientId], references: [id], onDelete: SetNull)

  /// Ledger row created with this sale (1:1).
  movementId String            @unique
  movement   InventoryMovement @relation(fields: [movementId], references: [id], onDelete: Cascade)

  createdById String?
  createdBy   User?   @relation("InventorySaleCreator", fields: [createdById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId, soldAt])
  @@index([itemId])
  @@index([clientId])
  @@index([bankAccountId])
}

/// Stock ledger: purchases (+), project issues (−), adjustments (±), write-offs / sold-offs (−).
/// On-hand stock = sum(quantity) for non-voided rows (also cached on InventoryItem).
model InventoryMovement {
  id       String                @id @default(cuid())
  type     InventoryMovementType
  /// Signed quantity: + for purchase / positive adj; − for issue / negative adj.
  quantity Decimal               @db.Decimal(14, 3)
  /// Unit cost locked at movement time (weighted avg for issues / write-offs / sold-offs).
  unitCost Decimal               @db.Decimal(14, 2)
  /// Absolute cost impact: abs(quantity) * unitCost. Project cost uses ISSUE_TO_PROJECT totalCost.
  /// For SOLD_OFF this is inventory cost basis leaving stock — sale proceeds live on InventorySale.
  totalCost Decimal              @db.Decimal(14, 2)
  movedAt   DateTime
  notes     String?

  /// Soft-void: excluded from stock/cost sums. Stock cache is restored/reduced on void (no reverse ADJUSTMENT).
  voidedAt    DateTime?
  voidReason  String?

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  itemId String
  item   InventoryItem @relation(fields: [itemId], references: [id], onDelete: Restrict)

  projectId String?
  project   Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)

  createdById String?
  createdBy   User?   @relation("InventoryMovementCreator", fields: [createdById], references: [id])

  purchase InventoryPurchase?
  sale     InventorySale?
  /// Set when this ISSUE_TO_PROJECT movement was created by an equipment asset assignment.
  equipmentAsset EquipmentAsset?
  /// Equipment assets linked to a bulk inventory issue (qty N, one movement).
  equipmentAssetsFromBulkIssue EquipmentAsset[] @relation("EquipmentBulkIssue")
  /// Equipment assets retired by a stock write-off (qty N, one movement).
  equipmentAssetsFromWriteOff EquipmentAsset[] @relation("EquipmentWriteOff")
  /// Equipment assets retired by a sold-off (qty N, one movement).
  equipmentAssetsFromSoldOff EquipmentAsset[] @relation("EquipmentSoldOff")
  factoryReturnsSent         EquipmentFactoryReturn[] @relation("FactoryReturnSend")
  factoryReturnReceive       EquipmentFactoryReturn? @relation("FactoryReturnReceive")
  payrollDeduction           PayrollDeduction?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId, movedAt])
  @@index([itemId, voidedAt])
  @@index([projectId, type, voidedAt])
  @@index([type])
}

/// Discrete physical unit of an Equipment catalog item.
/// Asset code format: {ITEM_SKU}-A{n}, e.g. EQP-001-A1.
/// Codes are minted when warehouse sends a unit, not when it is purchased.
/// One open project assignment per asset at a time (mirrors ProjectAssignment for employees).
model EquipmentAsset {
  id        String               @id @default(cuid())
  /// Company-scoped unique readable code — {ITEM_SKU}-A{n} (e.g. EQP-001-A1, EQP-001-A10).
  assetCode String

  status EquipmentAssetStatus @default(AVAILABLE)

  itemId String
  item   InventoryItem @relation(fields: [itemId], references: [id], onDelete: Restrict)

  /// Populated while status is ON_PROJECT.
  projectId String?
  project   Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)

  /// Per-asset ISSUE_TO_PROJECT movement from the equipment picker (qty −1 each).
  /// Voided on individual release — mirrors how consumable void returns stock.
  movementId String?            @unique
  movement   InventoryMovement? @relation(fields: [movementId], references: [id], onDelete: SetNull)

  /// Bulk inventory issue movement (qty N) — many assets may share one movement.
  /// Cleared when the issue is voided or the asset is released.
  issueMovementId String?
  issueMovement   InventoryMovement? @relation("EquipmentBulkIssue", fields: [issueMovementId], references: [id], onDelete: SetNull)

  /// Stock write-off movement that retired this asset. Cleared on write-off reversal.
  writeOffMovementId String?
  writeOffMovement   InventoryMovement? @relation("EquipmentWriteOff", fields: [writeOffMovementId], references: [id], onDelete: SetNull)

  /// Sold-off movement that retired this asset.
  soldOffMovementId String?
  soldOffMovement   InventoryMovement? @relation("EquipmentSoldOff", fields: [soldOffMovementId], references: [id], onDelete: SetNull)

  assignedAt DateTime?

  /// Ex-tax purchase unit cost locked when this physical unit was minted (Equipment only).
  /// Independent of catalog avgUnitCost — later purchases must not revalue older assets.
  /// Never store tax-inclusive (gross) amounts here. Nullable for legacy rows;
  /// backfill from item avg/last cost or last purchase (also expected ex-tax).
  unitCost Decimal? @db.Decimal(14, 2)

  /// Manufacturer / physical serial number (optional, user-set).
  serialNo String?
  notes    String?
  /// Model year for vehicle assets. Unused for equipment.
  vehicleYear Int?

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  factoryReturns EquipmentFactoryReturn[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([companyId, assetCode])
  @@index([companyId, status])
  @@index([itemId, status])
  @@index([projectId])
}

/// Equipment sent back to the factory for refund, repair, or replacement.
/// Uncoded new warehouse units have no assetId. Coded units keep their code.
model EquipmentFactoryReturn {
  id String @id @default(cuid())

  quantity Decimal @default(1) @db.Decimal(14, 3)
  sentAt   DateTime
  originalIntent FactoryReturnIntent
  status   FactoryReturnStatus @default(WAITING)
  reason   String

  /// Factory refund recorded on send or later while hanging.
  refundAmount Decimal? @db.Decimal(14, 2)
  refundedAt   DateTime?
  receivedAt   DateTime?

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  itemId String
  item   InventoryItem @relation(fields: [itemId], references: [id], onDelete: Restrict)

  /// Null when sending never-issued (uncoded) warehouse stock.
  assetId String?
  asset   EquipmentAsset? @relation(fields: [assetId], references: [id], onDelete: SetNull)

  vendorId String?
  vendor   Vendor? @relation(fields: [vendorId], references: [id], onDelete: SetNull)

  sendMovementId String?
  sendMovement   InventoryMovement? @relation("FactoryReturnSend", fields: [sendMovementId], references: [id], onDelete: SetNull)

  receiveMovementId String? @unique
  receiveMovement   InventoryMovement? @relation("FactoryReturnReceive", fields: [receiveMovementId], references: [id], onDelete: SetNull)

  createdById String?
  createdBy   User? @relation("FactoryReturnCreator", fields: [createdById], references: [id], onDelete: SetNull)

  closedById String?
  closedBy   User? @relation("FactoryReturnCloser", fields: [closedById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId, status])
  @@index([itemId, status])
  @@index([assetId])
}

/// Manual Internal Payroll deduction or payable line for one employee-month.
model PayrollDeduction {
  id String @id @default(cuid())

  year   Int
  month  Int
  type   PayrollDeductionType
  amount Decimal @db.Decimal(14, 2)
  reason String?

  /// Lost stock: catalog item or typed name.
  itemName  String?
  quantity  Decimal? @db.Decimal(14, 3)

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  projectId String?
  project   Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)

  inventoryItemId String?
  inventoryItem   InventoryItem? @relation(fields: [inventoryItemId], references: [id], onDelete: SetNull)

  /// Set only when this line created the inventory movement (void on delete).
  inventoryMovementId String?            @unique
  inventoryMovement   InventoryMovement? @relation(fields: [inventoryMovementId], references: [id], onDelete: SetNull)

  createdById String?
  createdBy   User?   @relation("PayrollDeductionCreator", fields: [createdById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([employeeId, year, month])
  @@index([companyId, year, month])
  @@index([projectId, type])
}

/// Company paid a client for a site incident (e.g. stolen property). Project expense.
model ProjectExpense {
  id String @id @default(cuid())

  category String @default("CLIENT_COMPENSATION")
  amount   Decimal @db.Decimal(14, 2)
  reason   String
  incurredAt DateTime @default(now())

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  employeeId String?
  employee   Employee? @relation(fields: [employeeId], references: [id], onDelete: SetNull)

  createdById String?
  createdBy   User? @relation("ProjectExpenseCreator", fields: [createdById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([projectId, incurredAt])
  @@index([companyId, incurredAt])
}

/// Frozen Internal Payroll period after HO Generate PDF. Unlock is HO-only.
model InternalPayrollLock {
  id        String  @id @default(cuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  year   Int
  month  Int
  locked Boolean @default(false)

  lockedAt     DateTime?
  lockedById   String?
  lockedBy     User?   @relation("InternalPayrollLocker", fields: [lockedById], references: [id], onDelete: SetNull)
  lockedByName String?

  unlockedAt     DateTime?
  unlockedById   String?
  unlockedBy     User?   @relation("InternalPayrollUnlocker", fields: [unlockedById], references: [id], onDelete: SetNull)
  unlockedByName String?
  unlockReason   String?

  /// Employee pay + day list at last Generate (attendance edits cannot change this).
  snapshot Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([companyId, year, month])
}

/// Operational Manager Full pay / custom amount when a day is under 9 or 18 hours.
model InternalPayrollDayDecision {
  id        String  @id @default(cuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  workDate DateTime @db.Date
  year     Int
  month    Int

  isDoubleShift Boolean
  requiredHours Int
  hoursWorked   Decimal  @db.Decimal(6, 2)
  status        InternalPayrollDayDecisionStatus
  paidAmount    Decimal  @db.Decimal(14, 2)

  decidedById String?
  decidedBy   User?     @relation("InternalPayrollDayDecider", fields: [decidedById], references: [id], onDelete: SetNull)
  decidedAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([companyId, employeeId, workDate])
  @@index([companyId, year, month])
  @@index([employeeId, workDate])
}

/// Annual THR (Idul Fitri) entitlement snapshot per employee.
model ThrPayment {
  id String @id @default(cuid())

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  year         Int
  hariRayaDate DateTime @db.Date
  amount       Decimal  @db.Decimal(14, 2)
  /// Base pay used when the row was generated.
  basePaySnapshot Decimal @db.Decimal(14, 2)
  tenureMonths    Int
  status          ThrPaymentStatus @default(GENERATED)
  generatedAt     DateTime         @default(now())
  paidAt          DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([employeeId, year])
  @@index([companyId, year])
}

/// Money remitted to BPJS for a contribution month (employee holding + company share).
model BpjsRemittance {
  id        String @id @default(cuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  year    Int
  month   Int
  program BpjsProgram
  amount  Decimal     @db.Decimal(14, 2)
  paidAt  DateTime    @db.Date
  reference String?
  notes     String?

  createdById String?
  createdBy   User?   @relation("BpjsRemittanceCreator", fields: [createdById], references: [id], onDelete: SetNull)

  purchaseInvoiceId String?
  purchaseInvoice   PurchaseInvoice? @relation(fields: [purchaseInvoiceId], references: [id], onDelete: SetNull)
  /// Company-share portion of this remittance. Employee holding is not P&L.
  companyShareAmount Decimal? @db.Decimal(14, 2)

  createdAt DateTime @default(now())

  @@index([companyId, year, month, program])
  @@index([purchaseInvoiceId])
}

model AuditLog {
  id String @id @default(cuid())

  action      String
  entity      String
  entityId    String?
  description String?

  ipAddress String?
  userAgent String?
  oldValue Json?
  newValue Json?

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  userId String?
  user   User? @relation(fields: [userId], references: [id])

  createdAt DateTime @default(now())

  @@index([companyId])
  @@index([userId])
}

/// Field staff request (only while CICO'd into the project). OM approves in Approvals.
model MaterialRequest {
  id     String                @id @default(cuid())
  status MaterialRequestStatus @default(REQUESTED)
  notes  String?
  reviewNote String?

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  requestedById String
  requestedBy   Employee @relation("MaterialRequestRequester", fields: [requestedById], references: [id], onDelete: Restrict)

  reviewedById String?
  reviewedBy   User?     @relation("MaterialRequestReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  reviewedAt   DateTime?

  lines         MaterialRequestLine[]
  transferOrder TransferOrder?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId, status])
  @@index([projectId])
  @@index([requestedById])
}

model MaterialRequestLine {
  id       String  @id @default(cuid())
  quantity Decimal @db.Decimal(14, 3)
  notes    String?

  materialRequestId String
  materialRequest   MaterialRequest @relation(fields: [materialRequestId], references: [id], onDelete: Cascade)

  itemId String
  item   InventoryItem @relation(fields: [itemId], references: [id], onDelete: Restrict)

  @@index([materialRequestId])
  @@index([itemId])
}

/// Created when a material request is approved. Warehouse sends; site receives.
model TransferOrder {
  id     String              @id @default(cuid())
  status TransferOrderStatus @default(PENDING_SEND)
  notes  String?

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  materialRequestId String          @unique
  materialRequest   MaterialRequest @relation(fields: [materialRequestId], references: [id], onDelete: Cascade)

  sentAt   DateTime?
  sentById String?
  sentBy   User?     @relation("TransferOrderSender", fields: [sentById], references: [id], onDelete: SetNull)

  receivedAt   DateTime?
  receivedById String?
  receivedBy   Employee? @relation("TransferOrderReceiver", fields: [receivedById], references: [id], onDelete: SetNull)

  lines TransferOrderLine[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId, status])
  @@index([projectId])
}

model TransferOrderLine {
  id       String  @id @default(cuid())
  quantity Decimal @db.Decimal(14, 3)

  transferOrderId String
  transferOrder   TransferOrder @relation(fields: [transferOrderId], references: [id], onDelete: Cascade)

  itemId String
  item   InventoryItem @relation(fields: [itemId], references: [id], onDelete: Restrict)

  @@index([transferOrderId])
  @@index([itemId])
}

/// Parking: HO-entered actual monthly revenue. Deal terms stay on Project.
model ParkingMonthlyLog {
  id            String  @id @default(cuid())
  year          Int
  month         Int
  revenueAmount Decimal @db.Decimal(14, 2)
  notes         String?

  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  createdById String?
  createdBy   User?   @relation("ParkingLogCreator", fields: [createdById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([projectId, year, month])
  @@index([projectId])
}

/// Payroll Management: one client employee-pay list per calendar month.
model PayrollManagementPeriod {
  id     String                         @id @default(cuid())
  year   Int
  month  Int
  status PayrollManagementPeriodStatus  @default(DRAFT)

  /// Snapshot of project.serviceFeePercent when the list is saved.
  serviceFeePercent Decimal @db.Decimal(5, 2)
  wagesTotal        Decimal @db.Decimal(14, 2) @default(0)
  feeAmount         Decimal @db.Decimal(14, 2) @default(0)
  /// Tax on the management fee only (not on wages).
  taxRatePercent    Decimal @db.Decimal(5, 2) @default(11)
  taxAmount         Decimal @db.Decimal(14, 2) @default(0)
  clientBillAmount  Decimal @db.Decimal(14, 2) @default(0)
  notes             String?

  invoicePeriodId String? @unique
  invoicePeriod   ProjectInvoicePeriod? @relation(fields: [invoicePeriodId], references: [id], onDelete: SetNull)

  wagesPaidAt     DateTime?
  wagesPaidById   String?
  wagesPaidBy     User?     @relation("PayrollPeriodWagesPaidBy", fields: [wagesPaidById], references: [id], onDelete: SetNull)
  wagesPaidProofPath String?

  invoicedAt      DateTime?
  invoicedById    String?
  invoicedBy      User?     @relation("PayrollPeriodInvoicedBy", fields: [invoicedById], references: [id], onDelete: SetNull)
  invoiceDueAt    DateTime?

  reimbursedAt    DateTime?
  reimbursedById  String?
  reimbursedBy    User?     @relation("PayrollPeriodReimbursedBy", fields: [reimbursedById], references: [id], onDelete: SetNull)
  paymentProofPath String?

  /// Frozen after Head Office Generate PDF (same idea as Internal Payroll lock).
  pdfLocked Boolean @default(false)
  pdfLockedAt DateTime?
  pdfLockedById String?
  pdfLockedBy User? @relation("PayrollPeriodPdfLocker", fields: [pdfLockedById], references: [id], onDelete: SetNull)
  pdfLockedByName String?
  pdfUnlockedAt DateTime?
  pdfUnlockedById String?
  pdfUnlockedBy User? @relation("PayrollPeriodPdfUnlocker", fields: [pdfUnlockedById], references: [id], onDelete: SetNull)
  pdfUnlockedByName String?
  pdfUnlockReason String?
  pdfSnapshot Json?

  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  createdById String?
  createdBy   User?   @relation("PayrollPeriodCreator", fields: [createdById], references: [id])

  lines PayrollManagementLine[]
  dayDecisions PayrollManagementDayDecision[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([projectId, year, month])
  @@index([projectId, status])
}

/// Client's employees that RGS must pay for a Payroll Management period.
model PayrollManagementLine {
  id            String  @id @default(cuid())
  employeeName  String
  amount        Decimal @db.Decimal(14, 2)
  accountNumber String?
  notes         String?
  sortOrder     Int     @default(0)

  periodId String
  period   PayrollManagementPeriod @relation(fields: [periodId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([periodId])
}

/// Full pay / custom amount for a Payroll Management day under 9 or 18 hours.
model PayrollManagementDayDecision {
  id String @id @default(cuid())

  periodId String
  period   PayrollManagementPeriod @relation(fields: [periodId], references: [id], onDelete: Cascade)

  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  workDate DateTime @db.Date
  isDoubleShift Boolean
  requiredHours Int
  hoursWorked   Decimal @db.Decimal(6, 2)
  status        InternalPayrollDayDecisionStatus
  paidAmount    Decimal @db.Decimal(14, 2)

  decidedById String?
  decidedBy   User?     @relation("PayrollManagementDayDecider", fields: [decidedById], references: [id], onDelete: SetNull)
  decidedAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([periodId, employeeId, workDate])
  @@index([employeeId, workDate])
}
